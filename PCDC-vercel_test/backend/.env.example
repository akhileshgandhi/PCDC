# Copy to backend/.env and fill in. Never commit the real .env.
# With docker-compose, DATABASE_URL and APP_BASE_URL are set by
# docker-compose.yml, so you can leave them out here.

DATABASE_URL=postgresql+psycopg2://user:password@host:5432/pcdc

# JWT signing
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider: "gemini" or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Fallback provider when Gemini is unavailable
OPENAI_API_KEY=

# Google Sign-In (login only)
GOOGLE_CLIENT_ID=

# Outbound email (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=PCDC

# Base URL used in emailed "set your password" links
APP_BASE_URL=http://localhost:8080
